  },
  "ladder": [
    {"level": 1, "model": "gpt-6-luna", "independent_reviewers": 2},
    {"level": 2, "model": "gpt-6.1-sol", "independent_reviewers": 2},
    {"level": 3, "model": "gpt-6-astra", "independent_reviewers": 2}
  ],
  "review_policy": {
    "same_frozen_candidate_per_level": true,
    "both_reviews_required_before_escalation": true,
    "constructed_objections_block_escalation": true,
    "retain_original_failure_evidence": true,
    "independent_registered_regression_required": true,
    "independent_repair_recheck_required": true,
    "missing_or_unavailable_review_blocks": true,
    "input_mutation_invalidates_release_evidence": true,
    "llm_opinion_is_not_claim_discharge": true,
    "manual_override_allowed": false
  },
  "closure_requirements": {
    "frozen_finite_claims": true,
    "canonical_input_manifest": true,
    "registered_hashed_verifiers": true,
    "explicit_trusted_computing_base": true,
    "unique_implementation_proof_correspondence": true,
    "checked_concrete_witnesses": true,
    "required_isolated_clean_builds": 2,
    "determinism_required": true,
    "public_claim_provenance_required": true,
    "unresolved_is_blocking": true,
    "warning_affecting_required_claim_is_blocking": true,
    "final_required_state": "VERIFIED"
  },
  "example_policy": {
    "synthetic_per_syntactic_factor": 50,
    "unchanged_authentic_per_syntactic_factor": 50,
    "retain_exact_input_and_immutable_source_provenance": true,
    "do_not_execute_downloaded_sql_or_setup": true,
    "do_not_pad_shortages_with_transformed_or_synthetic_sources": true,
    "source_origin_does_not_supply_catalog_or_validity": true
  },
  "initial_preflight": {
